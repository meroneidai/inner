APP_NAME=InnerPath
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_AVAILABLE_LOCALES=ar,en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Prefer MySQL in production
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=innerpath
DB_USERNAME=root
DB_PASSWORD=

# Local fallback without MySQL:
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@innerpath.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DREAM_MEDIA_DISK=local

# ---- AI (OpenRouter — default for dream analysis / ChatGPT) ----
AI_PROVIDER=openrouter
AI_AUTO_ANALYZE=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_ANALYSIS_MODEL=openai/gpt-4o
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_SITE_URL="${APP_URL}"
OPENROUTER_APP_NAME="${APP_NAME}"
AI_TIMEOUT=120
AI_MAX_RETRIES=3

# ---- OpenAI (optional: Whisper transcription / fallback) ----
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.4

# ---- Speech-to-Text (OpenAI Whisper) ----
TRANSCRIPTION_PROVIDER=openai
OPENAI_WHISPER_MODEL=whisper-1
TRANSCRIPTION_LANGUAGE=ar
TRANSCRIPTION_TIMEOUT=180

PATTERN_WEIGHT_FREQUENCY=0.30
PATTERN_WEIGHT_RECENT=0.25
PATTERN_WEIGHT_CONTEXT=0.20
PATTERN_WEIGHT_EMOTION=0.15
PATTERN_WEIGHT_TEMPORAL=0.10

VITE_APP_NAME="${APP_NAME}"
